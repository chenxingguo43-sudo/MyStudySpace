{
  "schema": "reader-production-config-v1",
  "defaultPreset": "claude-opus",
  "presets": {
    "claude-opus": {
      "batchSize": 2,
      "generatorAttempts": 2,
      "escalationAttempts": 1,
      "generator": {
        "command": ["node", "scripts/reader-claude-adapter.js", "--model", "opus", "--effort", "high"]
      },
      "reviewer": {
        "command": ["node", "scripts/reader-claude-adapter.js", "--model", "opus", "--effort", "high"]
      },
      "escalation": {
        "command": ["node", "scripts/reader-claude-adapter.js", "--model", "opus", "--effort", "max"]
      }
    }
  }
}
