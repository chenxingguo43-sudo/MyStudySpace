    {
      "id": "llm-10",
      "category": "memory_boundary",
      "title": "记忆只作为相关背景，不强行引用",
      "session": {
        "mode": "daily",
        "identity": "russian_friend",
        "turnIndex": 2,
        "userSpeakingRatio": 0.62
      },
      "conversation": [
        {
          "role": "assistant",
          "text": "Как прошёл твой день?"
        }
      ],
      "asr": {
        "zh": {
          "text": "今天工作有点累。",
          "segments": []
        },
        "ru": {
          "text": "Сегодня я немного устал после работы.",
          "segments": []
        }
      },
      "userConfirmedTranscript": "Сегодня я немного устал после работы.",
      "memory": [
        {
          "content": "用户上个月计划学习摄影",
          "confidence": 0.95,
          "status": "active",
          "lastMentioned": "2026-07-01"
        }
      ],
      "policy": {
        "targetLanguage": "ru",
        "memoryRule": "use_only_if_relevant"
      },
      "expected": {
        "intent": "用户今天工作后有些累",
        "shouldClarify": false,
        "replyLanguage": "ru",
        "mustAcknowledgeCurrentTurn": true,
        "mustNot": [
          "突然谈摄影",
          "把旧记忆当作本轮事实",
          "编造用户今天的安排"
        ]
      }
    },
    {
      "id": "llm-11",
      "category": "memory_candidate",
      "title": "区分临时事实与可写入记忆",
      "session": {
        "mode": "daily",
        "identity": "russian_friend",
        "turnIndex": 2,
        "userSpeakingRatio": 0.6
      },
      "conversation": [
        {
          "role": "assistant",
          "text": "Что тебе нравится делать в свободное время?"
        }
      ],
      "asr": {
        "zh": {
          "text": "我最近开始喜欢做饭。",
          "segments": []
        },
        "ru": {
          "text": "В последнее время мне нравится готовить.",
          "segments": []
        }
      },
      "userConfirmedTranscript": "В последнее время мне нравится готовить.",
      "memory": [],
      "policy": {
        "targetLanguage": "ru",
        "memoryRule": "candidate_requires_confidence_and_source"
      },
      "expected": {
        "intent": "用户最近喜欢做饭",
        "shouldClarify": false,
        "replyLanguage": "ru",
        "memoryCandidateAllowed": true,
        "memoryCandidateMustContain": [
          "来源为本轮用户表达",
          "置信度",
          "可过期或待确认"
        ],
        "mustNot": [
          "直接写成永久偏好",
          "把一次表达标记为已掌握"
        ]
      }
    },
    {
      "id": "llm-12",
      "category": "output_contract",
      "title": "结构化回复可供字幕/TTS/支架使用",
      "session": {
        "mode": "daily",
        "identity": "russian_friend",
        "turnIndex": 1,
        "userSpeakingRatio": 0.0
      },
      "conversation": [],
      "asr": {
        "zh": {
          "text": "我想聊电影。",
          "segments": []
        },
        "ru": {
          "text": "Я хочу поговорить о кино.",
          "segments": []
        }
      },
      "userConfirmedTranscript": "Я хочу поговорить о кино.",
      "memory": [],
      "policy": {
        "targetLanguage": "ru",
        "requireStructuredOutput": true
      },
      "expected": {
        "mustBeValidJson": true,
        "requiredFields": [
          "understanding",
          "reply",
          "reply.text",
          "reply.segments",
          "learning",
          "learning.keywords",
          "learning.scaffoldLevel",
          "control",
          "control.needsClarification"
        ],
        "segmentsMustBeOrdered": true,
        "segmentsMustBeTtsReady": true,
        "mustNot": [
          "Markdown 包裹 JSON",
          "额外输出 schema 外的自然语言",
          "把中文解释混入俄语 TTS 段落"
        ]
      }
    }
  ]
}