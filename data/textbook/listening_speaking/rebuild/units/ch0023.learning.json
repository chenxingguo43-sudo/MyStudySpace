  "segments": [
    {
      "segmentId": "ch0023-s001",
      "text": "Имею честь говорить с академиком Сретенским?",
      "translation": "请问，我有幸在和斯列坚斯基院士说话吗？",
      "playlistIndex": 0,
      "startTime": 5.57,
      "endTime": 6.69,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        1
      ]
    },
    {
      "segmentId": "ch0023-s002",
      "text": "Да.",
      "translation": "是的。",
      "playlistIndex": 0,
      "startTime": 8.29,
      "endTime": 9.03,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        2
      ]
    },
    {
      "segmentId": "ch0023-s003",
      "text": "Имеете эту честь.",
      "translation": "你有这个荣幸。",
      "playlistIndex": 0,
      "startTime": 9.15,
      "endTime": 9.93,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        3
      ]
    },
    {
      "segmentId": "ch0023-s004",
      "text": "Только я крайне занят.",
      "translation": "只是我非常忙。",
      "playlistIndex": 0,
      "startTime": 11.27,
      "endTime": 12.51,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        4
      ]
    },
    {
      "segmentId": "ch0023-s005",
      "text": "Есть дело, не терпящее отлагательств.",
      "translation": "有一件刻不容缓的事。",
      "playlistIndex": 0,
      "startTime": 13.97,
      "endTime": 17.23,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        5
      ]
    },
    {
      "segmentId": "ch0023-s006",
      "text": "Константин Николаевич Котиков.",
      "translation": "康斯坦丁·尼古拉耶维奇·季科夫（Константин Николаевич Котиков）。",
      "playlistIndex": 0,
      "startTime": 19.43,
      "endTime": 20.79,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        6
      ]
    },
    {
      "segmentId": "ch0023-s007",
      "text": "Кандидат наук, кафедра биохимии.",
      "translation": "副博士，生物化学教研室。",
      "playlistIndex": 0,
      "startTime": 22.66,
      "endTime": 24.82,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        7
      ]
    },
    {
      "segmentId": "ch0023-s008",
      "text": "Очень рад.",
      "translation": "非常高兴。",
      "playlistIndex": 0,
      "startTime": 25.26,
      "endTime": 25.66,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        8
      ]
    },
    {
      "segmentId": "ch0023-s009",
      "text": "Но я действительно крайне занят, коллега.",
      "translation": "但我确实非常忙，同事。",
      "playlistIndex": 0,
      "startTime": 28.7,
      "endTime": 30.96,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        9
      ]
    },
    {
      "segmentId": "ch0023-s010",
      "text": "День рождения внучки.",
      "translation": "孙女过生日。",
      "playlistIndex": 0,
      "startTime": 31.52,
      "endTime": 32.74,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        10
      ]
    },
    {
      "segmentId": "ch0023-s011",
      "text": "Поздравляю.",
      "translation": "恭喜。",
      "playlistIndex": 0,
      "startTime": 33.96,
      "endTime": 34.76,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        11
      ]
    },
    {
      "segmentId": "ch0023-s012",
      "text": "У меня дело чрезвычайной важности.",
      "translation": "我有一件万分重要的事。",
      "playlistIndex": 0,
      "startTime": 37.24,
      "endTime": 40.84,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        12
      ]
    },
    {
      "segmentId": "ch0023-s013",
      "text": "Я прошу пять минут.",
      "translation": "我请求五分钟时间。",
      "playlistIndex": 0,
      "startTime": 41.56,
      "endTime": 42.54,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        13
      ]
    },
    {
      "segmentId": "ch0023-s014",
      "text": "Прошу!..",
      "translation": "请讲！",
      "playlistIndex": 0,
      "startTime": 45.22,
      "endTime": 45.56,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        14
      ]
    },
    {
      "segmentId": "ch0023-s015",
      "text": "Итак?..",
      "translation": "……那么？",
      "playlistIndex": 0,
      "startTime": 64.08,
      "endTime": 64.42,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        15
      ]
    },
    {
      "segmentId": "ch0023-s016",
      "text": "Три года назад, листая один старинный журнальчик, я натолкнулся на вашу статью, которую вы опубликовали, едва выйдя из университета.",
      "translation": "……\r\n\r\n**季科夫：** 三年前，我在翻阅一本旧杂志时，偶然发现了您刚从大学毕业时发表的一篇文章。",
      "playlistIndex": 0,
      "startTime": 68.02,
      "endTime": 76.42,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        16
      ]
    },
    {
      "segmentId": "ch0023-s017",
      "text": "В ней излагался принцип синтеза нового белка.",
      "translation": "文中阐述了一种新蛋白质的合成原理。",
      "playlistIndex": 0,
      "startTime": 80.34,
      "endTime": 85.56,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        17
      ]
    },
    {
      "segmentId": "ch0023-s018",
      "text": "Это была абсолютно безумная идея по тем временам.",
      "translation": "在当时那完全是疯狂的想法。",
      "playlistIndex": 0,
      "startTime": 85.56,
      "endTime": 90.4,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        18
      ]
    },
    {
      "segmentId": "ch0023-s019",
      "text": "Вы получали белок из клеток головного мозга.",
      "translation": "您从脑细胞中提取蛋白质。",
      "playlistIndex": 0,
      "startTime": 90.9,
      "endTime": 93.32,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        19
      ]
    },
    {
      "segmentId": "ch0023-s020",
      "text": "Вы могли бы стать новым Эйнштейном!",
      "translation": "您本可以成为新的爱因斯坦！",
      "playlistIndex": 0,
      "startTime": 95,
      "endTime": 96.14,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        20
      ]
    },
    {
      "segmentId": "ch0023-s021",
      "text": "Если бы не отказались от этой затеи, чтоб потом всю жизнь заниматься Бог знает чем!",
      "translation": "如果不是您放弃了这个想法，然后一辈子去搞天知道什么东西的话！",
      "playlistIndex": 0,
      "startTime": 98.1,
      "endTime": 101.88,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        21
      ]
    },
    {
      "segmentId": "ch0023-s022",
      "text": "Послушайте!",
      "translation": "您听我说！",
      "playlistIndex": 0,
      "startTime": 104.58,
      "endTime": 105.08,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        22
      ]
    },
    {
      "segmentId": "ch0023-s023",
      "text": "Оставьте нас в покое!",
      "translation": "别管我们了！",
      "playlistIndex": 0,
      "startTime": 106.04,
      "endTime": 124.13,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        23
      ]
    },
    {
      "segmentId": "ch0023-s024",
      "text": "Вы уже тогда всё предсказали про этот самый белок, стабилизирующий функцию мозга!",
      "translation": "您在那时就已经预言了这种稳定大脑功能的蛋白质的一切！",
      "playlistIndex": 0,
      "startTime": 133.61,
      "endTime": 138.11,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        24
      ]
    },
    {
      "segmentId": "ch0023-s025",
      "text": "Вы обогнали науку на полвека!",
      "translation": "您领先了科学半个世纪！",
      "playlistIndex": 0,
      "startTime": 139.13,
      "endTime": 140.57,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        25
      ]
    },
    {
      "segmentId": "ch0023-s026",
      "text": "Однако с тех пор наука давно обогнала меня.",
      "translation": "然而从那以后，科学早已超越了我。",
      "playlistIndex": 0,
      "startTime": 141.41,
      "endTime": 143.83,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        26
      ]
    },
    {
      "segmentId": "ch0023-s027",
      "text": "Ни в коей мере!",
      "translation": "绝对没有！",
      "playlistIndex": 0,
      "startTime": 144.33,
      "endTime": 145.17,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        27
      ]
    },
    {
      "segmentId": "ch0023-s028",
      "text": "Только сейчас ваши идеи ещё брезжат в толковых умах!",
      "translation": "只是现在您的想法才刚刚在有识之士的头脑中浮现。",
      "playlistIndex": 0,
      "startTime": 145.39,
      "endTime": 148.53,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        28
      ]
    },
    {
      "segmentId": "ch0023-s029",
      "text": "Вот.",
      "translation": "给。",
      "playlistIndex": 0,
      "startTime": 149.91,
      "endTime": 150.13,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        29
      ]
    },
    {
      "segmentId": "ch0023-s030",
      "text": "Ваша схема с моими поправками.",
      "translation": "这是您的方案，附有我的修改。",
      "playlistIndex": 0,
      "startTime": 151.11,
      "endTime": 152.67,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        30
      ]
    }
  ],
