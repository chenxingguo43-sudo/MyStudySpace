    {
      "segmentId": "ch0001-s001",
      "text": "Юль, привет!",
      "translation": "尤拉，你好！",
      "playlistIndex": 0,
      "startTime": 5.3,
      "endTime": 6.38,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s002",
      "text": "Давно не виделись!",
      "translation": "好久没见了！",
      "playlistIndex": 0,
      "startTime": 6.86,
      "endTime": 7.72,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s003",
      "text": "Говорят, тебя можно поздравить?!",
      "translation": "听说可以祝贺你了？！",
      "playlistIndex": 0,
      "startTime": 8.14,
      "endTime": 9.68,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s004",
      "text": "Да... сама не знаю... получится... не получится...",
      "translation": "是啊……我自己也不知道……能不能成……",
      "playlistIndex": 0,
      "startTime": 10.26,
      "endTime": 14.94,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s005",
      "text": "Ну подумай, какой из меня начальник!",
      "translation": "你想想看，我哪像能当领导的人！",
      "playlistIndex": 0,
      "startTime": 16.16,
      "endTime": 18.54,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s006",
      "text": "Характер не тот!",
      "translation": "性格不合适！",
      "playlistIndex": 0,
      "startTime": 18.96,
      "endTime": 19.8,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s007",
      "text": "И коллектив, прямо скажем, не подарок!",
      "translation": "而且说实话，这个团队也不好带！",
      "playlistIndex": 0,
      "startTime": 20.56,
      "endTime": 22.62,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0001-s008",
      "text": "Тут жёсткость нужна, а я так не могу, ты ж меня знаешь...",
      "translation": "这里需要强硬些，可我做不到，你又不是不了解我……",
      "playlistIndex": 0,
      "startTime": 23.26,
      "endTime": 27.32,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    }
  ],
