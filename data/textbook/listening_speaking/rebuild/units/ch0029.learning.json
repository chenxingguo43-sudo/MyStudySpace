  "segments": [
    {
      "segmentId": "ch0029-s001",
      "text": "Привет, Лёша!",
      "translation": "你好，廖沙！",
      "playlistIndex": 0,
      "startTime": 8.43,
      "endTime": 9.25,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s002",
      "text": "Расскажи нам немного о себе, где учился и кем работаешь?",
      "translation": "简单介绍一下自己，在哪里上学、做什么工作？",
      "playlistIndex": 0,
      "startTime": 10.31,
      "endTime": 14.21,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s003",
      "text": "Привет!",
      "translation": "你好！",
      "playlistIndex": 0,
      "startTime": 14.85,
      "endTime": 15.27,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s004",
      "text": "Собственно зовут меня Лёша, мне 26 лет, живу и работаю в г.",
      "translation": "我叫廖沙，26岁，在",
      "playlistIndex": 0,
      "startTime": 16.11,
      "endTime": 20.51,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s005",
      "text": "Москва, до этого учился и проживал в г.",
      "translation": "莫斯科生活和工作；此前在",
      "playlistIndex": 0,
      "startTime": 20.83,
      "endTime": 23.77,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s006",
      "text": "Сургут.",
      "translation": "苏尔古特学习和居住。",
      "playlistIndex": 0,
      "startTime": 24.07,
      "endTime": 24.41,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s007",
      "text": "Там же окончил школу и университет, в котором отучился на специальность инженера.",
      "translation": "在那里完成了中小学和大学教育，学的是工程师专业。",
      "playlistIndex": 0,
      "startTime": 25.79,
      "endTime": 30.29,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s008",
      "text": "Сейчас работаю художником.",
      "translation": "现在从事绘画工作。",
      "playlistIndex": 0,
      "startTime": 31.27,
      "endTime": 33.03,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s009",
      "text": "Как ты нашёл свой стиль?",
      "translation": "你是怎么找到自己的风格的？",
      "playlistIndex": 0,
      "startTime": 33.89,
      "endTime": 35.33,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s010",
      "text": "Как ты его совершенствуешь?",
      "translation": "你如何完善它？",
      "playlistIndex": 0,
      "startTime": 36.13,
      "endTime": 37.59,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s011",
      "text": "Ещё не нашёл!",
      "translation": "还没找到呢！",
      "playlistIndex": 0,
      "startTime": 38.19,
      "endTime": 38.99,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s012",
      "text": "Я на самом деле до сих пор в поиске, пробую многое и разное, различные стили, приёмы работы с цветом и т. д.",
      "translation": "说真的，我一直在探索中，尝试各种不同的东西——不同的风格、色彩运用手法等等。",
      "playlistIndex": 0,
      "startTime": 39.73,
      "endTime": 47.69,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s013",
      "text": "Твоя самая удачная работа?",
      "translation": "你最成功的作品是哪幅？",
      "playlistIndex": 0,
      "startTime": 48.61,
      "endTime": 50.23,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s014",
      "text": "Та, над которой работаю сейчас.",
      "translation": "就是现在正在画的这幅。",
      "playlistIndex": 0,
      "startTime": 50.85,
      "endTime": 51.89,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s015",
      "text": "А если в плане удачной картинки, то такой, я думаю, нет, всегда есть за что себя упрекнуть и заставить в следующий раз делать лучше.",
      "translation": "如果说成功的画作，我觉得没有，总有让自己不满意的地方，可以鞭策自己下次画得更好。",
      "playlistIndex": 0,
      "startTime": 52.53,
      "endTime": 61.11,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s016",
      "text": "Как, по твоему мнению, должен развиваться художник?",
      "translation": "你认为画家应该如何发展？",
      "playlistIndex": 0,
      "startTime": 61.49,
      "endTime": 64.45,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s017",
      "text": "Что может способствовать его продвижению в творческой деятельности?",
      "translation": "什么能促进其在创作活动中的进步？",
      "playlistIndex": 0,
      "startTime": 65.09,
      "endTime": 68.73,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s018",
      "text": "Должен?!",
      "translation": "应该发展？！",
      "playlistIndex": 0,
      "startTime": 69.33,
      "endTime": 69.99,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s019",
      "text": "Обязан!",
      "translation": "必须发展！",
      "playlistIndex": 0,
      "startTime": 70.69,
      "endTime": 71.39,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s020",
      "text": "Если художник не развивается, то зачем он вообще рисует?",
      "translation": "如果画家不进步，那他画画还有什么意义？",
      "playlistIndex": 0,
      "startTime": 71.83,
      "endTime": 75.07,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s021",
      "text": "Продвижением как раз и должно стать саморазвитие и совершенствование.",
      "translation": "进步就应该体现在自我发展和自我完善上。",
      "playlistIndex": 0,
      "startTime": 75.93,
      "endTime": 79.73,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s022",
      "text": "Чем больше ты рисуешь, тем больше понимаешь, как мало ты знаешь, чему тебе нужно научиться и сколько перед тобой непознанного.",
      "translation": "你画得越多，就越明白自己懂得多么少，越清楚自己需要学什么，面前还有多少未知。",
      "playlistIndex": 0,
      "startTime": 80.49,
      "endTime": 88.73,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s023",
      "text": "Творческого человека это должно подталкивать к учёбе и развитию, иначе он ничего не добьётся.",
      "translation": "这应该推动创作者学习和发展，否则他将一事无成。",
      "playlistIndex": 0,
      "startTime": 89.43,
      "endTime": 94.93,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s024",
      "text": "Чем ещё занимаешься помимо рисования?",
      "translation": "除了画画你还做什么？",
      "playlistIndex": 0,
      "startTime": 95.61,
      "endTime": 97.97,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s025",
      "text": "Может хобби.",
      "translation": "有什么爱好吗？",
      "playlistIndex": 0,
      "startTime": 98.91,
      "endTime": 99.65,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s026",
      "text": "Моё хобби — это рисовать!",
      "translation": "我的爱好就是画画！",
      "playlistIndex": 0,
      "startTime": 100.17,
      "endTime": 101.45,
      "timingStatus": "source-bounded",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s027",
      "text": "Просто сейчас оно идёт параллельно с работой.",
      "translation": "只不过现在它和工作同步进行了。",
      "playlistIndex": 0,
      "startTime": 102.29,
      "endTime": 104.89,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s028",
      "text": "Но, помимо этого, играю в компьютерные игры, чтобы отдохнуть.",
      "translation": "除此之外，我还玩电脑游戏来放松。",
      "playlistIndex": 0,
      "startTime": 105.33,
      "endTime": 108.75,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s029",
      "text": "Какие планы на будущее?",
      "translation": "未来有什么计划？",
      "playlistIndex": 0,
      "startTime": 108.75,
      "endTime": 110.75,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s030",
      "text": "Какая цель или мечта?",
      "translation": "有什么目标或梦想？",
      "playlistIndex": 0,
      "startTime": 111.53,
      "endTime": 113.17,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s031",
      "text": "С чем-то глобальным ещё не определился.",
      "translation": "关于宏大的目标还没想好。",
      "playlistIndex": 0,
      "startTime": 113.47,
      "endTime": 115.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s032",
      "text": "И последний вопрос.",
      "translation": "最后一个问题。",
      "playlistIndex": 0,
      "startTime": 116.29,
      "endTime": 117.23,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s033",
      "text": "Представь свою жизнь без графического планшета.",
      "translation": "想象一下没有数位板的生活。",
      "playlistIndex": 0,
      "startTime": 118.37,
      "endTime": 121.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s034",
      "text": "Чем займёшься?",
      "translation": "你会做什么？",
      "playlistIndex": 0,
      "startTime": 122.25,
      "endTime": 123.05,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0029-s035",
      "text": "Создам графический планшет.",
      "translation": "造一块数位板。",
      "playlistIndex": 0,
      "startTime": 123.45,
      "endTime": 125.11,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    }
  ],
