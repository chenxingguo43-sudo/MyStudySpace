  "segments": [
    {
      "segmentId": "ch0020-s001",
      "text": "Во-первых, у меня насморк.",
      "translation": "首先，我感冒了。",
      "playlistIndex": 0,
      "startTime": 5.11,
      "endTime": 7.69,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        1
      ]
    },
    {
      "segmentId": "ch0020-s002",
      "text": "Когда затыкают рот, совершенно нечем дышать.",
      "translation": "堵上嘴的时候根本没法呼吸。",
      "playlistIndex": 0,
      "startTime": 7.77,
      "endTime": 9.85,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        2
      ]
    },
    {
      "segmentId": "ch0020-s003",
      "text": "А во-вторых, ещё раз повторяю, что ты хам и дурак.",
      "translation": "其次，我再说一遍，你是个粗人兼蠢货。",
      "playlistIndex": 0,
      "startTime": 11.15,
      "endTime": 15.63,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        3
      ]
    },
    {
      "segmentId": "ch0020-s004",
      "text": "Ты можешь забить меня до смерти, но нашего человека в ЧК я тебе не назову.",
      "translation": "你可以把我打死，但契卡里我们的人，我不会告诉你。",
      "playlistIndex": 0,
      "startTime": 16.33,
      "endTime": 20.49,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        4
      ]
    },
    {
      "segmentId": "ch0020-s005",
      "text": "Только за золото.",
      "translation": "除非用黄金换。",
      "playlistIndex": 0,
      "startTime": 20.81,
      "endTime": 21.87,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        5
      ]
    },
    {
      "segmentId": "ch0020-s006",
      "text": "Понял?",
      "translation": "明白吗？",
      "playlistIndex": 0,
      "startTime": 22.21,
      "endTime": 22.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        6
      ]
    },
    {
      "segmentId": "ch0020-s007",
      "text": "Поделим поровну и разбежимся, и забудем, как сон.",
      "translation": "我们平分了各跑各的，就像做了场梦一样忘掉。",
      "playlistIndex": 0,
      "startTime": 29.12,
      "endTime": 32.7,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        8
      ]
    },
    {
      "segmentId": "ch0020-s008",
      "text": "Ведь у тебя больше червонца в кармане никогда не было.",
      "translation": "你口袋里从来没有过超过一个金币的钱。",
      "playlistIndex": 0,
      "startTime": 42.56,
      "endTime": 44.7,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        9
      ]
    },
    {
      "segmentId": "ch0020-s009",
      "text": "А тут двести пятьдесят тысяч.",
      "translation": "而现在有二十五万。",
      "playlistIndex": 0,
      "startTime": 49.38,
      "endTime": 51.8,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        10
      ]
    },
    {
      "segmentId": "ch0020-s010",
      "text": "Ты что, меня на себе понесёшь, что ли?",
      "translation": "怎么，你要背着我走吗？",
      "playlistIndex": 0,
      "startTime": 54.15,
      "endTime": 55.41,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        12
      ]
    },
    {
      "segmentId": "ch0020-s011",
      "text": "Жаль, меня есаул не убил.",
      "translation": "可惜哥萨克中尉没把我打死。",
      "playlistIndex": 0,
      "startTime": 59.03,
      "endTime": 60.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        13
      ]
    },
    {
      "segmentId": "ch0020-s012",
      "text": "Ну зачем тебе это надо?",
      "translation": "你到底为什么要这个？",
      "playlistIndex": 0,
      "startTime": 86.95,
      "endTime": 87.91,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        18
      ]
    },
    {
      "segmentId": "ch0020-s013",
      "text": "Скажи мне, я хочу знать.",
      "translation": "告诉我，我想知道。",
      "playlistIndex": 0,
      "startTime": 88.61,
      "endTime": 89.83,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        19
      ]
    },
    {
      "segmentId": "ch0020-s014",
      "text": "Ну скажи, зачем тебе это надо?",
      "translation": "说啊，你为什么要这个？",
      "playlistIndex": 0,
      "startTime": 89.97,
      "endTime": 92.09,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        20
      ]
    },
    {
      "segmentId": "ch0020-s015",
      "text": "Ну принесёшь, ну принесёшь ты это золото, ну и что?",
      "translation": "你就算把这黄金带回去，又能怎样？",
      "playlistIndex": 0,
      "startTime": 92.35,
      "endTime": 97.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        21
      ]
    },
    {
      "segmentId": "ch0020-s016",
      "text": "Но они же тебя за это же золото и расстреляют.",
      "translation": "他们会因为这黄金把你枪毙的。",
      "playlistIndex": 0,
      "startTime": 98.47,
      "endTime": 102.11,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        22
      ]
    },
    {
      "segmentId": "ch0020-s017",
      "text": "Понимаешь?",
      "translation": "明白吗？",
      "playlistIndex": 0,
      "startTime": 102.17,
      "endTime": 102.81,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        23
      ]
    },
    {
      "segmentId": "ch0020-s018",
      "text": "Расстреляют...",
      "translation": "枪毙……",
      "playlistIndex": 0,
      "startTime": 103.99,
      "endTime": 104.83,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        24
      ]
    },
    {
      "segmentId": "ch0020-s019",
      "text": "Вон.",
      "translation": "你看。",
      "playlistIndex": 0,
      "startTime": 105.41,
      "endTime": 105.83,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        25
      ]
    },
    {
      "segmentId": "ch0020-s020",
      "text": "Вон же граница!",
      "translation": "边界就在那儿！",
      "playlistIndex": 0,
      "startTime": 106.45,
      "endTime": 108.33,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        26
      ]
    },
    {
      "segmentId": "ch0020-s021",
      "text": "Уходи!",
      "translation": "走吧！",
      "playlistIndex": 0,
      "startTime": 109.85,
      "endTime": 110.53,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        27
      ]
    },
    {
      "segmentId": "ch0020-s022",
      "text": "Не будь же ты кретином!",
      "translation": "别犯傻了！",
      "playlistIndex": 0,
      "startTime": 110.59,
      "endTime": 112.85,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        28
      ]
    },
    {
      "segmentId": "ch0020-s023",
      "text": "Это, это надо одному, а не всем!",
      "translation": "这东西只需要一个人拥有，不是所有人！",
      "playlistIndex": 0,
      "startTime": 113.45,
      "endTime": 116.19,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        29
      ]
    },
    {
      "segmentId": "ch0020-s024",
      "text": "Понимаешь?!",
      "translation": "明白吗？！",
      "playlistIndex": 0,
      "startTime": 116.63,
      "endTime": 117.25,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        30
      ]
    },
    {
      "segmentId": "ch0020-s025",
      "text": "Одному!",
      "translation": "一个人！",
      "playlistIndex": 0,
      "startTime": 117.79,
      "endTime": 118.31,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        31
      ]
    },
    {
      "segmentId": "ch0020-s026",
      "text": "Уходи!",
      "translation": "走吧！",
      "playlistIndex": 0,
      "startTime": 118.93,
      "endTime": 119.65,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        32
      ]
    },
    {
      "segmentId": "ch0020-s027",
      "text": "Такое бывает только раз, раз в жизни.",
      "translation": "这种事一辈子只有一次。",
      "playlistIndex": 0,
      "startTime": 120.11,
      "endTime": 122.95,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        33
      ]
    },
    {
      "segmentId": "ch0020-s028",
      "text": "Только раз.",
      "translation": "只有一次。",
      "playlistIndex": 0,
      "startTime": 123.57,
      "endTime": 124.17,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        34
      ]
    },
    {
      "segmentId": "ch0020-s029",
      "text": "Ты пойми.",
      "translation": "你想想。",
      "playlistIndex": 0,
      "startTime": 124.77,
      "endTime": 125.27,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        35
      ]
    },
    {
      "segmentId": "ch0020-s030",
      "text": "Раз!..",
      "translation": "只有一次！……",
      "playlistIndex": 0,
      "startTime": 126.01,
      "endTime": 126.39,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        36
      ]
    },
    {
      "segmentId": "ch0020-s031",
      "text": "Потому что ты жадный, а даже Бог велел делиться.",
      "translation": "因为你贪心，连上帝都说要分享。",
      "playlistIndex": 0,
      "startTime": 147.7,
      "endTime": 152.38,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        40
      ]
    },
    {
      "segmentId": "ch0020-s032",
      "text": "И вообще — помолчи.",
      "translation": "总之，闭嘴。",
      "playlistIndex": 0,
      "startTime": 155.9,
      "endTime": 157.4,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        41
      ]
    },
    {
      "segmentId": "ch0020-s033",
      "text": "Дай отдохнуть.",
      "translation": "让我歇会儿。",
      "playlistIndex": 0,
      "startTime": 158.98,
      "endTime": 159.92,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        42
      ]
    },
    {
      "segmentId": "ch0020-s034",
      "text": "Мне ещё тебя на себе переть.",
      "translation": "我还得背着你走呢。",
      "playlistIndex": 0,
      "startTime": 161.58,
      "endTime": 162.94,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": [
        43
      ]
    },
    {
      "segmentId": "ch0020-s035",
      "text": "Ротшильд хренов...",
      "translation": "该死的罗斯柴尔德……",
