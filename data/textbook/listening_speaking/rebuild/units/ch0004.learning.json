    {
      "segmentId": "ch0004-s001",
      "text": "Как же я устала, Света...",
      "translation": "我真是累坏了，斯维塔……",
      "playlistIndex": 0,
      "startTime": 5.01,
      "endTime": 6.97,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s002",
      "text": "Сил моих больше нет...",
      "translation": "我一点力气都没有了……",
      "playlistIndex": 0,
      "startTime": 7.43,
      "endTime": 8.47,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s003",
      "text": "Одна сплошная работа!",
      "translation": "没完没了地工作！",
      "playlistIndex": 0,
      "startTime": 9.07,
      "endTime": 10.69,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s004",
      "text": "Никакой жизни!",
      "translation": "一点生活都没有！",
      "playlistIndex": 0,
      "startTime": 11.11,
      "endTime": 12.01,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s005",
      "text": "А у меня сейчас отпуск...",
      "translation": "而我现在在休假……",
      "playlistIndex": 0,
      "startTime": 12.87,
      "endTime": 15.15,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s006",
      "text": "Наслаждаюсь жизнью... читаю, гуляю...",
      "translation": "我享受生活……读书、散步……",
      "playlistIndex": 0,
      "startTime": 15.57,
      "endTime": 18.73,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s007",
      "text": "Вчера ходила на вернисаж.",
      "translation": "昨天我去看了画展开幕式。",
      "playlistIndex": 0,
      "startTime": 19.29,
      "endTime": 20.03,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s008",
      "text": "Сто лет не была!",
      "translation": "好多年没去了！",
      "playlistIndex": 0,
      "startTime": 20.81,
      "endTime": 21.27,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s009",
      "text": "Ты знаешь, на удивление интересные работы.",
      "translation": "你知道吗，作品出乎意料地有意思。",
      "playlistIndex": 0,
      "startTime": 21.89,
      "endTime": 24.07,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
      "segmentId": "ch0004-s010",
      "text": "Особенно из Бурятии.",
      "translation": "尤其是布里亚特来的作品。",
      "playlistIndex": 0,
      "startTime": 24.61,
      "endTime": 25.69,
      "timingStatus": "aligned",
      "sourceSentenceIndexes": []
    },
    {
