{
  "sourceFile": "俄语资料库/В мире людей 听力口语 Markdown版/翻译/Тема 1.6 -- ТРКИ-2 电影对话（Художественные фильмы — Диалоги） -- 中文对照.md",
  "translationSourceStatus": "needs_review",
  "entries": [
    {"segmentId":"ch0022-s001","text":"Всё из-за тебя!","translation":"都怪你！"},
    {"segmentId":"ch0022-s002","text":"Чё стоишь?","translation":"站着干嘛？"},
    {"segmentId":"ch0022-s003","text":"Раздевайся!","translation":"脱衣服！"},
    {"segmentId":"ch0022-s004","text":"Проходи!","translation":"进来！"},
    {"segmentId":"ch0022-s005","text":"Рубаху тоже снимать?","translation":"衬衫也要脱吗？"},
    {"segmentId":"ch0022-s006","text":"Прости, я тебя, наверное, не совсем правильно понял?","translation":"对不起，我可能没有完全理解你的意思？"},
    {"segmentId":"ch0022-s007","text":"Совсем неверно.","translation":"完全理解错了。"},
    {"segmentId":"ch0022-s008","text":"На...","translation":"给……"},
    {"segmentId":"ch0022-s009","text":"Чайник поставь!","translation":"把水壶烧上！"},
    {"segmentId":"ch0022-s010","text":"Кота покорми.","translation":"喂猫。"},
    {"segmentId":"ch0022-s011","text":"Еда в холодильнике!..","translation":"食物在冰箱里！……"},
    {"segmentId":"ch0022-s012","text":"Кошмар какой...","translation":"真是糟糕……"},
    {"segmentId":"ch0022-s013","text":"Ты зачем коту дал мою курицу?!","translation":"你为什么把我的鸡肉给猫吃了？！"},
    {"segmentId":"ch0022-s014","text":"Коты любят куриное мясо.","translation":"猫喜欢鸡肉。"},
    {"segmentId":"ch0022-s015","text":"Да?!","translation":"是吗？！"},
    {"segmentId":"ch0022-s016","text":"Я тоже его люблю!","translation":"我也喜欢！"},
    {"segmentId":"ch0022-s017","text":"Блин!","translation":"该死！"},
    {"segmentId":"ch0022-s018","text":"Чего ты чайник не поставил?","translation":"你怎么没烧水壶？"},
    {"segmentId":"ch0022-s019","text":"Блин.","translation":"该死。"},
    {"segmentId":"ch0022-s020","text":"Я тебя не пришибла часом?","translation":"我刚才没伤着你吧？"},
    {"segmentId":"ch0022-s021","text":"Может, ты зря в больницу не поехал?","translation":"也许你不去医院是白耽误了？"},
    {"segmentId":"ch0022-s022","text":"Нет-нет.","translation":"不不。"},
    {"segmentId":"ch0022-s023","text":"Я чувствую себя совершенно здоровым.","translation":"我感觉自己完全健康。"},
    {"segmentId":"ch0022-s024","text":"Точно?","translation":"确定？"},
    {"segmentId":"ch0022-s025","text":"Чайник ставят вот так.","translation":"水壶要这样烧。"},
    {"segmentId":"ch0022-s026","text":"Запомни.","translation":"记住。"},
    {"segmentId":"ch0022-s027","text":"Я пойду переоденусь.","translation":"我去换衣服。"},
    {"segmentId":"ch0022-s028","text":"Ты пальто досуши.","translation":"你把大衣晾干。"},
    {"segmentId":"ch0022-s029","text":"Оно в ванной.","translation":"它在浴室里。"},
    {"segmentId":"ch0022-s030","text":"А ванна вот здесь...","translation":"浴室在这儿……"},
    {"segmentId":"ch0022-s031","text":"Горячий воздух!","translation":"热风！"},
    {"segmentId":"ch0022-s032","text":"Очень горячий!","translation":"非常热！"},
    {"segmentId":"ch0022-s033","text":"А там что?","translation":"那里面有什么？"},
    {"segmentId":"ch0022-s034","text":"Вот фенов нет, да?","translation":"没有吹风机，对吧？"},
    {"segmentId":"ch0022-s035","text":"Ну а голову вы тогда чем сушите?","translation":"那你们平时用什么吹干头发？"},
    {"segmentId":"ch0022-s036","text":"Голову?","translation":"头发？"},
    {"segmentId":"ch0022-s037","text":"Прости, а зачем сушить голову?..","translation":"对不起，为什么要吹干头发？……"},
    {"segmentId":"ch0022-s038","text":"На.","translation":"给。"},
    {"segmentId":"ch0022-s039","text":"Чай будешь?","translation":"喝茶吗？"},
    {"segmentId":"ch0022-s040","text":"Зелёный, чёрный?..","translation":"绿茶，红茶？……"},
    {"segmentId":"ch0022-s041","text":"Чай?","translation":"茶？"},
    {"segmentId":"ch0022-s042","text":"Кофе?","translation":"咖啡？"},
    {"segmentId":"ch0022-s043","text":"Этот чай рос на склоне горы в провинции Сычуань.","translation":"这茶生长在四川省的一座山坡上。"},
    {"segmentId":"ch0022-s044","text":"Его собирала китайская девушка по имени Ли, которая любила человека по имени Чи Ян, но вышла замуж за Ли Женя, который работает на фабрике светодиодов.","translation":"是一个姓李的姑娘采摘的，她爱着一个叫奇阳的人，却嫁给了在发光二极管工厂工作的李仁佳。"},
    {"segmentId":"ch0022-s045","text":"А Чи Ян пока так и не женился...","translation":"而奇阳至今未婚……"},
    {"segmentId":"ch0022-s046","text":"Конфетка сливочная помадка с цукатами.","translation":"奶油太妃糖夹蜜饯。"},
    {"segmentId":"ch0022-s047","text":"Произведено на фабрике «Красный октябрь», сгущённая с сахаром, молоко, масло сливочное, патока, цукаты, коньяк, ароматизаторы, четыреста одиннадцать калорий...","translation":"\"红色十月\"工厂生产，配料有炼乳加糖、牛奶、黄油、糖浆、蜜饯、白兰地、食用香精，四百一十一卡路里……"},
    {"segmentId":"ch0022-s048","text":"Укладчица номер пять.","translation":"五号包装工。"},
    {"segmentId":"ch0022-s049","text":"Блондинка, крашеная, мать-одиночка, лет сорока пяти.","translation":"染了头发的金发单身母亲，大约四十五岁。"},
    {"segmentId":"ch0022-s050","text":"Извини, но ей тридцать два года, у неё волосы рыжего цвета и двое детей, близнецы Катя и Анжела.","translation":"抱歉，她三十二岁，头发是红褐色的，有两个孩子，双胞胎卡佳和安热拉。"},
    {"segmentId":"ch0022-s051","text":"Иногда она берёт конфеты домой.","translation":"有时她会把糖果带回家。"},
    {"segmentId":"ch0022-s052","text":"Если она не остановится, её скоро уволят.","translation":"如果她不停手，很快就会被解雇。"},
    {"segmentId":"ch0022-s053","text":"Это очень печально.","translation":"这很令人遗憾。"},
    {"segmentId":"ch0022-s054","text":"Ты кто, вообще?","translation":"你到底是干什么的？"},
    {"segmentId":"ch0022-s055","text":"Ну, то есть, занимаешься чем?","translation":"就是说，你做哪行？"},
    {"segmentId":"ch0022-s056","text":"Я помогаю людям.","translation":"我帮助人们。"}
  ]
}
