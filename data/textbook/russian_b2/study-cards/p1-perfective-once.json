  "overview": "完成体强调动作作为一个整体、一次完成或已经达到的结果。重点不是动词有没有前缀，而是语境是否把动作看作有界结果。",
  "decisionSteps": [
    "判断是否问一次完成或结果。",
    "寻找完成、达到、开始等界限信号。",
    "确认不是习惯、过程或重复。",
    "再核对对应体和时态。"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "动作是否有明确终点？",
      "句子是否强调一次结果？",
      "是否在叙述重复习惯？"
    ],
    "structures": [
      {
        "question": "一次完成",
        "structure": "完成体动词",
        "shortcut": "把动作看成一个有终点的整体。"
      },
      {
        "question": "结果",
        "structure": "完成体过去/将来时",
        "shortcut": "关注结果已到达或将到达。"
      }
    ],
    "comparison": "прочитал книгу：读完；читал книгу：在读/读过/经常读。",
    "mnemonic": "有结果、看整体，优先想完成体。"
  },
