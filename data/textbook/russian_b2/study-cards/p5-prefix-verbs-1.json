      "id": "l2",
      "title": "开始动作",
      "scope": "core",
      "meaning": "за- 可表示开始进行某种持续动作。",
      "conditions": [
        "句子强调动作刚开始。"
      ],
      "structure": "запеть / заговорить",
      "caseChanges": [
        {
          "from": "петь",
          "to": "запеть"
        }
      ],
      "examples": [
        {
          "ru": "Дети вдруг запели.",
          "zh": "孩子们突然唱了起来。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
