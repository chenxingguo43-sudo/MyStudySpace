  "overview": "前缀动词并非简单加义：它会改变方向、起点、终点或动作阶段。",
  "decisionSteps": [
    "找出基本运动或动作",
    "判断方向和结果",
    "核对时间与搭配"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "动作是进入、离开还是到达？",
      "强调开始、完成还是短暂尝试？"
    ],
    "structures": [
      "прийти / уйти",
      "запеть / заговорить",
      "поговорить",
      "сделать / написать"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "到达与离开",
      "scope": "core",
      "meaning": "при- 表示到达，у- 常表示离开。",
      "conditions": [
        "句子有明确终点或离开点。"
      ],
      "structure": "прийти / уйти",
      "caseChanges": [
        {
          "from": "дом",
          "to": "уйти из дома"
        }
      ],
      "examples": [
        {
          "ru": "Он пришёл в школу вовремя.",
          "zh": "他准时到了学校。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要只按中文“去”选动词。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "“Он пришёл в школу вовремя.”符合本节结构。",
          "answer": true,
          "rationale": "到达学校要求 при-。",
          "source": {
            "kind": "grammar-book",
            "label": "新编俄语语法",
