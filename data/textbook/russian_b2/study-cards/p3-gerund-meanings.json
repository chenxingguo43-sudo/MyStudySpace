  "overview": "副动词不能只翻成“……着”。它与主句可构成时间、条件、原因或让步关系，必须由上下文恢复逻辑。",
  "decisionSteps": [
    "先找主句动作",
    "判断副动作与主句关系",
    "核查主体是否一致"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "是先后、原因还是让步？",
      "两个动作是谁做的？"
    ],
    "structures": [
      "читая",
      "прочитав",
      "зная",
      "зная"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "同时动作",
      "scope": "core",
      "meaning": "未完成体副动词常表示同时进行。",
      "conditions": [
        "两个动作并行。"
      ],
      "structure": "читая",
      "caseChanges": [
        {
          "from": "читать",
          "to": "читая книгу"
        }
      ],
      "examples": [
        {
          "ru": "Читая книгу, он делал заметки.",
          "zh": "他读书时做笔记。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要机械理解为先后。"
      ],
      "instantChecks": [
