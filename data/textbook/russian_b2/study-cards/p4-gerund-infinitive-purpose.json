  "overview": "本卡区分副动词的伴随/先后关系与目的不定式。一个说明如何、何时做，另一个说明为什么去做。",
  "decisionSteps": [
    "判断第二个动作是伴随还是目标",
    "确认主体是否一致",
    "选择副动词或 чтобы + 不定式"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "行动是同时发生还是为了达成？",
      "两动作主体是否相同？"
    ],
    "structures": [
      "улыбаясь",
      "чтобы + инфинитив",
      "после того как",
      "когда + 从句"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "伴随动作",
      "scope": "core",
      "meaning": "副动词表示伴随或先后。",
      "conditions": [
        "同一主体执行两动作。"
      ],
      "structure": "улыбаясь",
      "caseChanges": [
        {
          "from": "улыбаться",
          "to": "улыбаясь, он вошёл"
        }
      ],
      "examples": [
        {
          "ru": "Улыбаясь, он вошёл в комнату.",
          "zh": "他微笑着走进房间。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把伴随动作当目的。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "улыбаясь 要根据句中关系选择。",
          "answer": true,
          "rationale": "微笑与进入同时发生。",
