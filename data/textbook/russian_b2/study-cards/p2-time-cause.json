{
  "id": "p2-time-cause",
  "partId": "p2",
  "knowledgePointId": "p2-time-cause",
  "title": "持续、原因与时间关系",
  "exerciseIds": [
    "P2-Q051",
    "P2-Q052",
    "P2-Q053",
    "P2-Q054",
    "P2-Q055",
    "P2-Q056",
    "P2-Q057",
    "P2-Q058"
  ],
  "overview": "本组练习区分时间的持续、经过多久后发生、在多久内完成、先后关系，以及产生结果的原因。先判断语义，再选择结构和格。",
  "decisionSteps": [
    "先判断动作是持续一段时间、经过多久后发生，还是在多久内完成。",
    "再判断结构表达时间先后，还是表达产生结果的原因。",
    "最后检查前置词要求的格和名词词形。"
  ],
  "rules": [
    {
      "structure": "时间段（第四格）",
      "meaning": "表示动作或状态持续多久时，时间段通常直接用第四格。",
      "source": {
        "kind": "b2-original",
        "label": "B2 原书考点",
        "pages": [
          34
        ]
      }
    },
    {
      "structure": "от + 第二格",
      "meaning": "可表示某种状态或感受产生的原因。",
      "source": {
        "kind": "b2-original",
        "label": "B2 原书考点",
        "pages": [
          34
        ]
      }
    },
    {
      "structure": "через + 时间",
      "meaning": "表示经过一段时间以后发生。",
      "source": {
        "kind": "b2-original",
        "label": "B2 原书考点",
        "pages": [
          34
        ]
      }
    },
    {
      "structure": "после + 第二格；за … до …",
      "meaning": "前者表示在某事之后；后者表示在某个事件之前的提前时间。",
      "source": {
        "kind": "b2-original",
        "label": "B2 原书考点",
        "pages": [
          35
        ]
      }
    },
    {
      "structure": "за + 时间",
      "meaning": "强调在一段时间内完成一个动作或达到结果。",
      "source": {
        "kind": "grammar-book",
        "label": "新编俄语语法",
        "file": "08 前置词.md",
        "section": "表示时间意义的前置词辨析",
        "pages": [
          297
        ]
      }
    },
    {
      "structure": "благодаря + 第三格",
      "meaning": "表示产生积极结果的原因。",
      "source": {
        "kind": "grammar-book",
        "label": "新编俄语语法",
        "file": "08 前置词.md",
        "section": "前置词 благодаря, из-за",
        "pages": [
          304
        ]
      }
    },
    {
      "structure": "из-за + 第二格",
      "meaning": "表示造成消极或不良结果的外在原因。",
      "source": {
        "kind": "grammar-book",
        "label": "新编俄语语法",
        "file": "08 前置词.md",
        "section": "前置词 благодаря, из-за",
        "pages": [
          305
        ]
      }
    }
  ],
  "comparisons": [
    {
      "left": "через неделю",
      "right": "за неделю",
      "note": "前者是“一周后发生”；后者是“在一周内完成”。",
      "source": {
        "kind": "study-supplement",
        "label": "学习补充"
      }
    },
    {
      "left": "благодаря помощи",
      "right": "из-за ошибки",
      "note": "前者关联积极结果；后者关联消极结果或外在不利原因。",
      "source": {
        "kind": "grammar-book",
        "label": "新编俄语语法",
        "file": "08 前置词.md",
        "section": "前置词 благодаря, из-за",
        "pages": [
          304,
          305
        ]
      }
    }
  ],
