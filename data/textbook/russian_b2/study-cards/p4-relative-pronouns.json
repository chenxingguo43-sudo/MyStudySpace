  "overview": "关系词同时受两套规则约束：性数来自先行词，格来自它在从句中的作用。",
  "decisionSteps": [
    "找先行词",
    "确定关系词在从句中担当什么成分",
    "组合性数与格"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "关系词指谁/什么？",
      "它在从句中是主语、宾语还是介词补语？"
    ],
    "structures": [
      "который / которая",
      "которую",
      "о котором",
      "тот, кто"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "性数来自先行词",
      "scope": "core",
      "meaning": "который 与先行词性数一致。",
      "conditions": [
        "先行词明确。"
      ],
      "structure": "который / которая",
      "caseChanges": [
        {
          "from": "книга",
          "to": "книга, которая"
        }
      ],
      "examples": [
        {
          "ru": "Книга, которая лежит на столе, новая.",
          "zh": "桌上的书是新的。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要按从句动词选择性别。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "который / которая 要根据句中关系选择。",
          "answer": true,
          "rationale": "книга 为阴性。",
