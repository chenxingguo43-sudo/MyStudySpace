      "scope": "core",
      "meaning": "确认真正控制谓语形式的成分。",
      "conditions": [
        "主语可能与最近名词不相邻。"
      ],
      "structure": "谁/什么（主格）→ 谓语",
      "caseChanges": [
        {
          "from": "Иванова",
          "to": "Иванова выступила"
        },
        {
          "from": "студенты",
          "to": "Студенты выступили"
        }
      ],
      "examples": [
