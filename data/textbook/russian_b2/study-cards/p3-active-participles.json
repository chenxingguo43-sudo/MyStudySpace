          ]
        }
      ]
    },
    {
      "id": "l4",
      "title": "形动词短语",
      "scope": "core",
      "meaning": "带补语的形动词短语仍整体修饰名词。",
      "conditions": [
        "先划出短语，再找中心名词。"
      ],
      "structure": "студент, читающий статью",
      "caseChanges": [
        {
          "from": "студент",
          "to": "студента, читающего статью"
        }
      ],
      "examples": [
        {
          "ru": "Я видел студента, читающего статью.",
          "zh": "我看见一名正在读文章的学生。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "短语内部宾语不决定形动词词尾。"
      ],
      "instantChecks": [
        {
          "id": "l4-check",
          "type": "judgment",
          "prompt": "студент, читающий статью 要根据句中关系选择。",
          "answer": true,
          "rationale": "第四格来自 видел 的宾语，形动词随 студент 变化。",
          "source": {
            "kind": "grammar-book",
