  "overview": "本卡把形容词、短尾形式与名词的固定支配关系分开学习。做题时不要按中文直译，先问“这个词要求谁、什么，用什么格”。",
  "decisionSteps": [
    "找形容词或名词中心词",
    "写出它要求的格",
    "让修饰语与名词一同变格"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "谁/什么被评价？",
      "补语由哪个词支配？"
    ],
    "structures": [
      "полный чего",
      "интересный кому-чему",
      "доволен кем-чем"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "第二格补语",
      "scope": "core",
      "meaning": "表示“充满、缺少、值得”等关系时，形容词常要求第二格。",
      "conditions": [
        "先找支配词或前置词，再判断所需的格与语义。"
      ],
      "structure": "полный + Р.п.",
      "caseChanges": [
        {
          "from": "полный",
          "to": "полный интересных книг"
        }
      ],
      "examples": [
        {
          "ru": "Зал был полон интересных книг.",
          "zh": "大厅里摆满了有趣的书。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把“满”后的内容误作第四格直接宾语。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "полный + Р.п. 的选择必须由支配关系和语义共同决定。",
          "answer": true,
          "rationale": "先确认结构要求，再检查词形。",
          "source": {
