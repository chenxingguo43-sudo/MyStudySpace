  "overview": "连接词的核心是逻辑关系：并列、对比、转折、说明、愿望或请求。不要只按一个中文词对译。",
  "decisionSteps": [
    "判断两部分关系",
    "选择连接词类型",
    "检查连接后的句法"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "是补充、对比还是转折？",
      "从句是在说明事实还是愿望？"
    ],
    "structures": [
      "и",
      "но",
      "что",
      "чтобы"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "联合关系",
      "scope": "core",
      "meaning": "и 连接并列或同时存在的信息。",
      "conditions": [
        "两部分没有冲突。"
      ],
      "structure": "и",
      "caseChanges": [
        {
          "from": "он читает",
          "to": "он читает и пишет"
        }
      ],
      "examples": [
        {
          "ru": "Он читает и пишет по-русски.",
          "zh": "他用俄语阅读并写作。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要用 но 连接纯并列动作。"
      ],
      "instantChecks": [
