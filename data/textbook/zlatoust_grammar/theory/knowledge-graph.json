{
  "schemaVersion": 1,
  "bookId": "zlatoust_grammar",
  "title": "В мире людей - 语法词汇",
  "relationTypes": [
    "prerequisite",
    "part-of",
    "shared-concept",
    "contrast",
    "confusable"
  ],
  "chapters": [
    { "id": "gl1", "label": "第一章：一致与动词体", "color": "1" },
    { "id": "gl2", "label": "第二章：格支配与语义关系", "color": "2" },
    { "id": "gl3", "label": "第三章：动名副词与主体", "color": "3" },
    { "id": "gl4", "label": "第四章：复句关系", "color": "4" },
    { "id": "gl5", "label": "第五章：会话构式与词汇", "color": "5" }
  ],
  "concepts": [
    {
      "id": "agreement-target",
      "label": "一致关系的控制中心",
      "summary": "先找究竟是哪个词、哪种句法成分在控制性、数或形式，再谈词尾。"
    },
    {
      "id": "speaker-focus",
      "label": "说话人的关注焦点",
      "summary": "同一客观事件可以因为说话人关注经历、过程、边界或结果而选择不同表达。"
    },
    {
      "id": "aspect-choice",
      "label": "动词体选择",
      "summary": "未完成体与完成体不是简单的没做完和做完，而是语境焦点、动作轮廓与交际任务的组合。"
    },
    {
      "id": "negation-scope",
      "label": "否定作用域",
      "summary": "先判断否定的是行为、结果、能力、许可还是风险，不能只看到 не 或 нельзя 就机械选形式。"
    },
    {
      "id": "infinitive-frame",
      "label": "不定式句法框架",
      "summary": "不定式的体和形式受上位动词、否定结构、情态意义与词汇支配共同限制。"
    },
    {
      "id": "case-government",
      "label": "格支配",
      "summary": "动词、短尾形容词和介词会给对象分配格；先找支配词，再确定介词与格。"
    },
    {
      "id": "attribute-relation",
      "label": "非一致定语关系",
      "summary": "先找中心名词，再判断后面的名词短语是不带介词、带介词还是不定式关系。"
    },
    {
      "id": "semantic-role",
      "label": "时间空间原因目的角色",
      "summary": "同一个名词短语要先判断它在句中承担时间、空间、原因还是目的角色，再选结构。"
    },
    {
      "id": "subject-control",
      "label": "动作主体控制",
      "summary": "动名副词能否使用取决于主动作与附加动作是否由同一个可恢复的行动者完成。"
    },
    {
      "id": "clause-relation",
      "label": "复句关系",
      "summary": "先判断分句之间是并列、定语、时间、原因还是条件关系，再选择连接手段。"
    },
    {
      "id": "timeline",
      "label": "时间线",
      "summary": "画出同时、先后、持续、截止和结果保留关系，能串联动词体、时间关系和时间从句。"
    },
    {
      "id": "communicative-intent",
      "label": "交际意图",
      "summary": "命令、邀请、警告、情绪评价、已知与未知信息会改变句式和形式选择。"
    },
    {
      "id": "lexical-collocation",
      "label": "词汇搭配与配价",
      "summary": "有些答案来自词汇本身的固定搭配和配价，不能只靠抽象语法规则推出。"
    }
  ],
  "sectionRelations": [
    { "from": "1.1", "to": "1.2", "type": "shared-concept", "reason": "两卡都要求先找一致关系的控制中心，再判断形式。" },
    { "from": "1.2", "to": "1.3", "type": "shared-concept", "reason": "两卡都先辨句法任务，不能从表面词尾直接得出结论。" },
    { "from": "1.3", "to": "2.2", "type": "prerequisite", "reason": "理解形容词全尾和短尾的句法区别，是学习短尾形容词对象支配的前提。" },
    { "from": "1.4.1", "to": "1.4.2", "type": "contrast", "reason": "1.4.1 建立肯定语境中的体选择，1.4.2 检查否定后焦点如何变化。" },
    { "from": "1.4.1", "to": "1.4.3", "type": "shared-concept", "reason": "两卡都围绕过程、结果、次数和边界解释动词体。" },
    { "from": "1.4.3", "to": "1.4.4", "type": "contrast", "reason": "1.4.3 主要看语义轮廓，1.4.4 强调上位词的词汇限制。" },
    { "from": "1.4.4", "to": "1.4.6", "type": "shared-concept", "reason": "两卡都要求先确认控制不定式的句法或词汇框架。" },
    { "from": "1.4.5", "to": "1.4.6", "type": "confusable", "reason": "нельзя 和其他否定不定式都含否定，但禁止、不可能、许可和担忧的结构不同。" },
    { "from": "1.4.7", "to": "1.4.8", "type": "contrast", "reason": "肯定命令与否定命令的交际意图和体选择不能互相套用。" },
    { "from": "1.4.2", "to": "1.5-review", "type": "part-of", "reason": "否定中的体选择是综合复习需要调用的一条判断路线。" },
    { "from": "1.4.3", "to": "1.5-review", "type": "part-of", "reason": "不定式中的过程、结果和次数判断进入综合复习。" },
    { "from": "1.4.4", "to": "1.5-review", "type": "part-of", "reason": "词汇语义限制进入综合复习。" },
    { "from": "1.4.5", "to": "1.5-review", "type": "part-of", "reason": "нельзя 的禁止与不可能分流进入综合复习。" },
    { "from": "1.4.6", "to": "1.5-review", "type": "part-of", "reason": "否定不定式的句法框架进入综合复习。" },
    { "from": "1.4.7", "to": "1.5-review", "type": "part-of", "reason": "肯定命令式的交际意图进入综合复习。" },
    { "from": "1.4.8", "to": "1.5-review", "type": "part-of", "reason": "否定命令式的禁止、警告和反事实进入综合复习。" },
    { "from": "2.1", "to": "2.2", "type": "contrast", "reason": "两卡都讲对象支配，但支配中心分别是动词和短尾形容词。" },
    { "from": "2.1", "to": "2.3", "type": "confusable", "reason": "第五格既可能由支配产生，也可能表达方式或伴随，需要分清关系。" },
    { "from": "2.4", "to": "2.4.1", "type": "part-of", "reason": "2.4.1 展开总览中的无介词非一致定语分支。" },
    { "from": "2.4", "to": "2.4.2", "type": "part-of", "reason": "2.4.2 展开总览中的有介词和不定式定语分支。" },
    { "from": "2.4.1", "to": "2.4.2", "type": "contrast", "reason": "两卡都修饰中心名词，但一个主要处理无介词关系，另一个处理有介词与不定式关系。" },
    { "from": "2.5", "to": "2.6", "type": "shared-concept", "reason": "时间和空间表达都必须先问名词短语在事件中承担什么角色。" },
    { "from": "2.7", "to": "2.8", "type": "confusable", "reason": "原因说明动作为什么发生，目的说明动作指向什么目标，中文都可能出现“为”。" },
    { "from": "3.1", "to": "3.1.1", "type": "part-of", "reason": "3.1.1 展开同一主体时允许使用动名副词的条件。" },
    { "from": "3.1", "to": "3.1.2", "type": "part-of", "reason": "3.1.2 展开主体分离、无主和被动时禁止使用的条件。" },
    { "from": "3.1.1", "to": "3.1.2", "type": "contrast", "reason": "一张建立允许条件，另一张建立禁止边界。" },
    { "from": "4.1", "to": "4.2", "type": "contrast", "reason": "4.1 连接并列分句，4.2 用关系词把定语从句依附到中心词。" },
    { "from": "4.3", "to": "4.4", "type": "contrast", "reason": "时间从句按时间线组织，раз 从句主要按既定事实、原因或条件路线组织。" },
    { "from": "5.1", "to": "5.2", "type": "shared-concept", "reason": "两卡都需要先判断说话人的交际意图和信息状态。" },
    { "from": "5.lexical", "to": "2.1", "type": "shared-concept", "reason": "词汇搭配经常决定动词配价和格支配。" },
    { "from": "5.lexical", "to": "4.2", "type": "shared-concept", "reason": "词汇搭配帮助区分关系词在真实复句中的自然使用。" },
    { "from": "1.4.1", "to": "2.5", "type": "shared-concept", "reason": "动词体和时间关系都需要判断动作在时间中的展开与边界。" },
    { "from": "2.5", "to": "4.3", "type": "prerequisite", "reason": "先掌握时间角色和时间线，再处理 когда、пока、пока не 的分句关系更稳。" }
  ],
  "conceptRelations": [
