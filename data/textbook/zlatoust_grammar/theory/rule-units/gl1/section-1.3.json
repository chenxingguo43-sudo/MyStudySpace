{
  "schemaVersion": 1,
  "id": "gl1-section-1.3",
  "chapterId": "gl1",
  "sectionId": "1.3",
  "titleRu": "Полная и краткая форма качественных прилагательных",
  "titleZh": "性质形容词全尾与短尾形式",
  "orientationZh": {
    "sourceType": "learning-note",
    "text": "全尾和短尾不仅是形态替换：它们会改变特征的恒常/临时、绝对/情境意义、格支配能力、句法位置及语体效果。"
  },
  "quickDecision": [
    {
      "sourceType": "learning-note",
      "text": "先判断是定语还是谓语，并观察是否有系词或不定式。"
    },
    {
      "sourceType": "learning-note",
      "text": "比较特征是恒常/绝对还是暂时/情境相关。"
    },
    {
      "sourceType": "learning-note",
      "text": "检查 особые signals：то/это/что/всё、как/так、какой/такой、格支配和语体。"
    }
  ],
  "semanticAnalysis": {
    "sourceType": "learning-note",
    "text": "全尾往往把性质当作对象较稳定、可直接描述的特征；短尾更容易把它说成“在当前条件下是怎样”或“对某事是否合适”。这不是绝对的时间对立，还会牵动句法位置、补足语和语体，因此先问句子要描述属性还是给出情境判断。"
  },
  "sourceRules": [
    {
      "id": "gl1-1.3-full-definition",
      "sourceType": "source-rule",
      "text": "Полная форма качественных прилагательных может быть определением перед определяемым словом или после него; при постпозиции она обособляется запятыми.",
      "source": {
        "pdfPages": [
          94
        ],
        "printedPages": [
          92
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-short-predicate",
      "sourceType": "source-rule",
      "text": "Полная и краткая формы могут быть предикатом; с прилагательными могут входить вспомогательные глаголы являться, казаться, становиться и связка быть.",
      "source": {
        "pdfPages": [
          94
        ],
        "printedPages": [
          92
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-permanent-vs-temporary",
      "sourceType": "source-rule",
      "text": "Полная форма указывает на постоянный признак и вневременное качество; краткая — на временный признак и недлительное состояние.",
      "source": {
        "pdfPages": [
          94
        ],
        "printedPages": [
          92
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-absolute-vs-relative",
      "sourceType": "source-rule",
      "text": "Полная форма обозначает абсолютный признак, не связанный с конкретной ситуацией; краткая — относительный признак, связанный с конкретной ситуацией.",
      "source": {
        "pdfPages": [
          94
        ],
        "printedPages": [
          92
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-short-case-government",
      "sourceType": "source-rule",
      "text": "Краткая форма способна управлять определённым падежом; полная форма в функции предиката такой способностью не обладает.",
      "source": {
        "pdfPages": [
          94
        ],
        "printedPages": [
          92
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-short-pronoun-or-clause",
      "sourceType": "source-rule",
      "text": "Краткая форма употребляется при субъекте то, это, что, всё и при дополнении, выраженном придаточной частью предложения.",
      "source": {
        "pdfPages": [
          95
        ],
        "printedPages": [
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-short-with-infinitive",
      "sourceType": "source-rule",
      "text": "При наличии инфинитива в предикате употребляется краткая форма.",
      "source": {
        "pdfPages": [
          95
        ],
        "printedPages": [
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-short-with-tak",
      "sourceType": "source-rule",
      "text": "При наличии слов как и так употребляется только краткая форма.",
      "source": {
        "pdfPages": [
          95
        ],
        "printedPages": [
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-full-kakoi-takoi",
      "sourceType": "source-rule",
      "text": "При наличии слов какой и такой употребляется только полная форма прилагательного.",
      "source": {
        "pdfPages": [
          95
        ],
        "printedPages": [
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-style-short-vs-full",
      "sourceType": "source-rule",
      "text": "Краткая форма характерна для литературного языка, полная — для разговорной речи; в газетно-публицистическом и художественном стилях краткая форма обладает большей экспрессивностью.",
      "source": {
        "pdfPages": [
          95
        ],
        "printedPages": [
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    },
    {
      "id": "gl1-1.3-predicative-instrumental",
      "sourceType": "source-rule",
      "text": "После являться, казаться, становиться и быть полная форма в функции предиката употребляется в творительном падеже.",
      "source": {
        "pdfPages": [
          94,
          95
        ],
        "printedPages": [
          92,
          93
        ],
        "source": "E:\\Desktop\\语法词汇（同一本书）.pdf"
      }
    }
  ],
