  "chapterId": "gl1",
  "sectionId": "1.2",
  "titleRu": "Согласование количественных сочетаний с глаголом",
  "titleZh": "数量表达与谓语的一致",
  "orientationZh": {
    "sourceType": "learning-note",
    "text": "数量主语可接单数或复数，必须同时看数量表达的类型、谓语位置、动作主动性和句法距离，不能凭数量大于一直接选复数。"
  },
  "quickDecision": [
    {
      "sourceType": "learning-note",
      "text": "先识别集合数量、度量数量还是普通数量名词组合。"
    },
    {
      "sourceType": "learning-note",
      "text": "检查谓语是否前置，或主语与谓语是否被其他成分隔开。"
    },
    {
      "sourceType": "learning-note",
      "text": "最后判断动作是主动参与还是被动状态。"
    }
  ],
  "semanticAnalysis": {
    "sourceType": "learning-note",
    "text": "数量短语并不总是把一群人当成“多个独立行动者”。说话人有时把它看作一个数量整体、度量或存在状态，单数更自然；当注意力落到多人主动分别参与的动作时，复数更容易出现。位置和距离会改变句子重心，所以数字本身不能裁决。"
  },
