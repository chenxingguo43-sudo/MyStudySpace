      "id": "l1",
      "title": "方向与地点",
      "scope": "core",
      "meaning": "в + 第四格表示去向，в + 第六格表示所在。",
      "conditions": [
        "先找支配词或前置词，再判断所需的格与语义。"
      ],
      "structure": "в школу / в школе",
      "caseChanges": [
        {
          "from": "школа",
          "to": "в школе"
        }
      ],
      "examples": [
        {
          "ru": "Дети идут в школу.",
