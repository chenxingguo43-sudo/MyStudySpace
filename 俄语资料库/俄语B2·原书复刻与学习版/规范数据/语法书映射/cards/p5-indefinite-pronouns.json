{
  "id": "p5-indefinite-pronouns",
  "partId": "p5",
  "knowledgePointId": "p5-indefinite-pronouns",
  "title": "不定代词：-нибудь 与 кое-",
  "exerciseIds": [
    "P5-Q018",
    "P5-Q019",
    "P5-Q020",
    "P5-Q021"
  ],
  "overview": "不定代词选择取决于说话人是否知道对象、句子是否是假设或请求，以及语体是否书面。",
  "decisionSteps": [
    "判断对象是否完全不确定",
    "看是否为条件、疑问或祈使",
    "区分说话人知道与不知道"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "说话人知道这个人/物吗？",
      "这是一种任意选择还是暗示已知对象？"
    ],
    "structures": [
      "кто-нибудь / что-нибудь",
      "кое-кто / кое-что",
      "кто-то / что-то",
      "кому-нибудь"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "-нибудь 的任意性",
      "scope": "core",
      "meaning": "-нибудь 表示不指定的任意对象。",
      "conditions": [
        "疑问、请求、条件和未来计划。"
      ],
      "structure": "кто-нибудь / что-нибудь",
      "caseChanges": [
        {
          "from": "кто",
          "to": "кто-нибудь"
        }
      ],
      "examples": [
        {
          "ru": "Позвоните мне, если кто-нибудь придёт.",
          "zh": "如果有人来，请给我打电话。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把它理解为说话人知道的特定人。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "“Позвоните мне, если кто-нибудь придёт.”符合本节结构。",
          "answer": true,
          "rationale": "条件语境强调不确定对象。",
          "source": {
