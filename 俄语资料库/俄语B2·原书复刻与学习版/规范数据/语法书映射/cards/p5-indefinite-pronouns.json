      "title": "-то 的具体出现",
      "scope": "core",
      "meaning": "-то 常指已经出现但未具体命名的人或物。",
      "conditions": [
        "叙述一个实际发生的事件。"
      ],
      "structure": "кто-то / что-то",
      "caseChanges": [
