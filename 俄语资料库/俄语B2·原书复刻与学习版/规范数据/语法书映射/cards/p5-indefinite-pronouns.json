    {
      "id": "l2",
      "title": "кое- 的已知性",
      "scope": "core",
      "meaning": "кое- 表示说话人知道但暂不说明。",
      "conditions": [
        "叙述中暗示具体但未点明的信息。"
      ],
      "structure": "кое-кто / кое-что",
      "caseChanges": [
        {
          "from": "кто",
          "to": "кое-кто"
        }
      ],
