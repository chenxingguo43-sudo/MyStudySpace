      "id": "l3",
      "title": "一般疑问",
      "scope": "core",
      "meaning": "是非问句多用 ли。",
      "conditions": [
        "原话没有疑问词。"
      ],
      "structure": "спросил, ли",
      "caseChanges": [
        {
          "from": "«Ты готов?»",
          "to": "спросил, готов ли"
