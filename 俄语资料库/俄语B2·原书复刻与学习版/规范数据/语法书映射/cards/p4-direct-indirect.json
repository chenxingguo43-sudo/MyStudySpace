      ]
    },
    {
      "id": "l2",
      "title": "命令与请求",
      "scope": "core",
      "meaning": "祈使句通常变为 чтобы 从句。",
      "conditions": [
        "原话表达要求或请求。"
      ],
      "structure": "попросил, чтобы",
      "caseChanges": [
        {
          "from": "«Позвони мне»",
          "to": "попросил, чтобы позвонил"
        }
      ],
      "examples": [
        {
          "ru": "Он попросил, чтобы я позвонил ему.",
          "zh": "他请求我给他打电话。",
