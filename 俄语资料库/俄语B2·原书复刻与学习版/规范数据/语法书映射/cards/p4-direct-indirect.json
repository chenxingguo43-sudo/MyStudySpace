{
  "id": "p4-direct-indirect",
  "partId": "p4",
  "knowledgePointId": "p4-direct-indirect",
  "title": "直接引语与间接引语",
  "exerciseIds": [
    "P4-Q050"
  ],
  "overview": "转换引语时，要把引用内容变成合适的从句，并同步调整人称、指示词和祈使/疑问结构。",
  "decisionSteps": [
    "识别原话类型",
    "选择 что/чтобы/疑问词",
    "调整人称与指示"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "原话是陈述、命令还是疑问？",
      "说话者和听话者改变了吗？"
    ],
    "structures": [
      "сказал, что",
      "попросил, чтобы",
      "спросил, ли",
      "спросил, где"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "陈述句",
      "scope": "core",
      "meaning": "陈述内容通常变为 что 从句。",
      "conditions": [
        "原话陈述事实。"
      ],
      "structure": "сказал, что",
      "caseChanges": [
        {
          "from": "«Я приду»",
          "to": "сказал, что придёт"
        }
      ],
      "examples": [
        {
          "ru": "Он сказал, что придёт позже.",
          "zh": "他说他会晚些来。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "人称要从引用场景调整。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "сказал, что 要根据句中关系选择。",
          "answer": true,
          "rationale": "陈述句用 что 连接。",
          "source": {
            "kind": "grammar-book",
            "label": "新编俄语语法",
            "file": "21 引语.md",
            "section": "用间接引语代换直接引语",
            "pages": [
              355,
              356
            ]
          }
        }
      ],
      "sources": [
