      "title": "走运与遭遇",
      "scope": "core",
      "meaning": "везти / повезти 等无人称动词说明某人走运。",
      "conditions": [
        "强调偶然顺利或不顺利。"
      ],
      "structure": "кому + повезло",
      "caseChanges": [
        {
          "from": "он",
          "to": "ему"
        }
      ],
      "examples": [
        {
