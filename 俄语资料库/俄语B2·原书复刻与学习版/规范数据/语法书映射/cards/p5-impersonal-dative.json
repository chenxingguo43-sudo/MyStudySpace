{
  "id": "p5-impersonal-dative",
  "partId": "p5",
  "knowledgePointId": "p5-impersonal-dative",
  "title": "无人称动词与与格主体",
  "exerciseIds": [
    "P5-Q045",
    "P5-Q046",
    "P5-Q047"
  ],
  "overview": "无人称结构里，体验者通常用与格；语法主语可能不存在，但意义上的“谁”仍然明确。",
  "decisionSteps": [
    "找出体验者",
    "把体验者改为与格",
    "判断谓语表达的状态或遭遇"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "谁感到、遇到或不得不做？",
      "句中有没有主格主语？"
    ],
    "structures": [
      "мне / ему + 谓语副词",
      "кому + повезло",
      "кому + приходится + 不定式",
      "кому + удалось + 不定式"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "与格体验者",
      "scope": "core",
      "meaning": "心理、生理或状态谓语常以与格表示体验者。",
      "conditions": [
        "句子没有普通主格主语。"
      ],
      "structure": "мне / ему + 谓语副词",
      "caseChanges": [
        {
          "from": "я",
          "to": "мне"
        }
      ],
      "examples": [
        {
          "ru": "Мне трудно говорить по-русски.",
          "zh": "我很难说俄语。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把 я 留在第一格。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "“Мне трудно говорить по-русски.”符合本节结构。",
          "answer": true,
          "rationale": "体验者在无人称句中用与格。",
          "source": {
            "kind": "grammar-book",
            "label": "新编俄语语法",
            "file": "07 副词.md",
