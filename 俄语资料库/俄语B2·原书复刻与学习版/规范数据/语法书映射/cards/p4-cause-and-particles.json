  "title": "原因结构与连接助词",
  "exerciseIds": [
    "P4-Q046",
    "P4-Q047",
    "P4-Q048",
    "P4-Q049"
  ],
  "overview": "原因可以用从属连接词、前置词短语或连接助词表达。要识别整个结构的功能，而非逐字翻译。",
  "decisionSteps": [
    "找原因与结果",
    "判断需要句子还是名词短语",
    "选择连接结构"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "原因后面是完整从句还是名词？",
      "语体是中性还是书面？"
    ],
    "structures": [
      "так как",
      "из-за + Р.п.",
      "так что",
      "ведь"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "原因从句",
      "scope": "core",
      "meaning": "так как 用完整从句给出理由。",
      "conditions": [
        "原因是一个分句。"
      ],
      "structure": "так как",
      "caseChanges": [
        {
          "from": "было поздно",
          "to": "так как было поздно"
        }
      ],
      "examples": [
        {
          "ru": "Так как было поздно, мы ушли.",
          "zh": "因为很晚了，我们离开了。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
