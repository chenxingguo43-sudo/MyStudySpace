{
  "id": "p6-predicate-case",
  "partId": "p6",
  "knowledgePointId": "p6-predicate-case",
  "title": "判断结构与工具格",
  "exerciseIds": [
    "P6-Q001",
    "P6-Q002",
    "P6-Q003",
    "P6-Q004",
    "P6-Q005",
    "P6-Q006",
    "P6-Q007",
    "P6-Q008"
