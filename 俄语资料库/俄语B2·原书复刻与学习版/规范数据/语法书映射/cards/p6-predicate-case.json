  "overview": "判断结构要区分“是什么/成为什么/被认为是什么”；很多动词要求工具格，而静词性谓语也有固定形式。",
  "decisionSteps": [
    "识别判断动词",
    "确定是身份、职务还是评价",
    "核对名词或形容词形式"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "谓语说明身份还是动作？",
      "动词是否要求工具格？"
    ],
    "structures": [
      "являться + Т.п.",
      "служить + Т.п.",
      "считаться + Т.п.",
      "назвать + Т.п."
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "являться + 工具格",
      "scope": "core",
      "meaning": "являться 表示正式的“是/属于”，后接工具格。",
      "conditions": [
        "书面或正式判断。"
      ],
      "structure": "являться + Т.п.",
      "caseChanges": [
        {
          "from": "основа",
          "to": "основой"
        }
      ],
      "examples": [
        {
          "ru": "Язык является основой общения.",
          "zh": "语言是交流的基础。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把它写成第一格并列。"
      ],
      "instantChecks": [
