      "ждать + В.п. / дождаться + Р.п.",
      "войти в / подойти к",
      "участвовать в + П.п.",
      "влиять на + В.п."
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "等待与期待",
      "scope": "core",
      "meaning": "ждать 直接支配第四格，дождаться 常支配第二格。",
      "conditions": [
        "句子强调过程或终于等到。"
      ],
      "structure": "ждать + В.п. / дождаться + Р.п.",
      "caseChanges": [
        {
          "from": "автобус",
          "to": "дождаться автобуса"
        }
      ],
      "examples": [
