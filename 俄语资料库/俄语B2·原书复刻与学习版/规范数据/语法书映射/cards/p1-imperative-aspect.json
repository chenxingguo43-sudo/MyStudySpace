  "overview": "命令式不仅是“命令”，还会表达请求、建议、提醒和禁止。体的选择决定动作被理解为一次完成、过程性行动还是避免不良行为。",
  "decisionSteps": [
    "先判断是请求、建议、禁止还是提醒。",
    "确定希望对方做一次结果还是进行活动。",
    "看到 не 时区分一般禁止和防止某次不良后果。",
    "最后选体和命令式形式。"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "是肯定命令还是否定？",
      "强调一次完成还是过程？",
      "是在禁止习惯还是提醒避免一次后果？"
    ],
    "structures": [
      {
        "question": "请求完成",
        "structure": "完成体命令式",
        "shortcut": "常用于请对方完成一次具体行为。"
      },
      {
        "question": "一般禁止",
        "structure": "не + 未完成体命令式",
        "shortcut": "强调不要做这种行为。"
      }
    ],
    "comparison": "Не опаздывай：别迟到（一般）；Не опоздай：别迟到这一次。",
    "mnemonic": "肯定看结果，否定先分一般禁止和一次警告。"
  },
