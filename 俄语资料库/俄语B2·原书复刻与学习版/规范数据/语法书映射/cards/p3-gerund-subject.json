{
  "id": "p3-gerund-subject",
  "partId": "p3",
  "knowledgePointId": "p3-gerund-subject",
  "title": "副动词的主体一致",
  "exerciseIds": [
    "P3-Q045",
    "P3-Q046",
    "P3-Q047",
    "P3-Q048",
    "P3-Q049",
    "P3-Q050"
  ],
  "overview": "副动词动作的执行者必须与主句逻辑主语一致。若主句没有共同主体，就不能直接使用副动词结构。",
  "decisionSteps": [
    "找副动词的执行者",
    "找主句逻辑主语",
    "比较二者是否相同"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "谁在做副动词动作？",
      "主句是谁完成的？"
    ],
    "structures": [
      "идя, он",
      "когда + 从句",
      "когда + 从句",
      "когда / после того как"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "共同主语",
      "scope": "core",
      "meaning": "副动词与主句主语必须同一人或物。",
      "conditions": [
        "句中主体明确一致。"
      ],
      "structure": "идя, он",
      "caseChanges": [
        {
          "from": "он",
          "to": "он, идя домой"
        }
      ],
      "examples": [
        {
          "ru": "Идя домой, он встретил друга.",
          "zh": "他回家时遇到了朋友。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要让宾语承担副动词动作。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
          "prompt": "идя, он 要根据句中关系选择。",
          "answer": true,
          "rationale": "两个动作都由 он 完成。",
          "source": {
            "kind": "grammar-book",
            "label": "新编俄语语法",
            "file": "06 动词.md",
            "section": "动词",
            "pages": [
              207,
              208
            ]
          }
        }
      ],
      "sources": [
        {
          "kind": "grammar-book",
          "label": "新编俄语语法",
          "file": "06 动词.md",
          "section": "动词",
          "pages": [
            207,
            208
          ]
        }
      ]
    },
    {
      "id": "l2",
      "title": "无人称结构限制",
      "scope": "core",
      "meaning": "无人称句通常无法给副动词提供共同主体。",
      "conditions": [
        "主句没有明确执行者时要改写。"
      ],
      "structure": "когда + 从句",
      "caseChanges": [
        {
          "from": "идти",
          "to": "когда идёшь по улице"
        }
      ],
      "examples": [
        {
          "ru": "Когда идёшь по улице, не кури.",
          "zh": "走在街上时，不要抽烟。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把副动词硬接到无人称谓语后。"
      ],
      "instantChecks": [
        {
          "id": "l2-check",
          "type": "judgment",
          "prompt": "когда + 从句 要根据句中关系选择。",
          "answer": true,
          "rationale": "无人称结构缺少可共享的主语，应改为从句。",
          "source": {
            "kind": "grammar-book",
            "label": "新编俄语语法",
            "file": "06 动词.md",
            "section": "动词",
            "pages": [
              207,
