        }
      ]
    },
    {
      "id": "l3",
      "title": "被动句限制",
      "scope": "core",
      "meaning": "被动句的主语是受事，常与副动词执行者不同。",
      "conditions": [
        "需要改为从句或主动句。"
      ],
      "structure": "когда + 从句",
      "caseChanges": [
        {
          "from": "письмо",
          "to": "письмо, написав"
        }
      ],
      "examples": [
        {
          "ru": "Письмо было отправлено после того, как я его написал.",
          "zh": "信是在我写完之后寄出的。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要写成“Написав письмо, оно было отправлено”。"
      ],
      "instantChecks": [
        {
          "id": "l3-check",
          "type": "judgment",
          "prompt": "когда + 从句 要根据句中关系选择。",
          "answer": true,
          "rationale": "写信的人不是 письмо。",
          "source": {
            "kind": "grammar-book",
