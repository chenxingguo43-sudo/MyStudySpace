    },
    {
      "id": "l4",
      "title": "改写策略",
      "scope": "core",
      "meaning": "主体不同就用从句或两个分句。",
      "conditions": [
        "先保留真实执行者。"
      ],
      "structure": "когда / после того как",
      "caseChanges": [
        {
          "from": "студент",
          "to": "когда студент пришёл"
        }
      ],
      "examples": [
        {
          "ru": "Когда студент пришёл, занятие началось.",
          "zh": "学生到了以后，课程开始了。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "改写比错误副动词更自然。"
      ],
      "instantChecks": [
        {
          "id": "l4-check",
          "type": "judgment",
          "prompt": "когда / после того как 要根据句中关系选择。",
          "answer": true,
          "rationale": "两个动作主体不同，因此使用从句。",
          "source": {
