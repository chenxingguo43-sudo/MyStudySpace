  "overview": "构词题先看词根和词缀提供的词性、方向和语义，再把候选词放回固定搭配。",
  "decisionSteps": [
    "确认空格需要的词性",
    "看前后缀改变了什么意义",
    "最后核对搭配"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "需要名词、形容词还是动词？",
      "词缀表达方向、否定还是结果？"
    ],
    "structures": [
      "в-/вы-/у- + 词根",
      "-ость / -ный / -но",
      "обсуждать + В.п.",
      "词义 + 语境"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "前缀改变词义",
      "scope": "core",
      "meaning": "前缀常补充方向、开始或结果意义。",
      "conditions": [
        "同一词根出现多个前缀形式。"
      ],
      "structure": "в-/вы-/у- + 词根",
      "caseChanges": [
        {
          "from": "ход",
          "to": "выход"
        }
      ],
      "examples": [
        {
          "ru": "Пассажиры вышли на следующей станции.",
          "zh": "乘客在下一站下车。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不能只按词根翻译。"
      ],
      "instantChecks": [
        {
