  "knowledgePointId": "p5-modal-infinitive",
  "title": "情态词与不定式",
  "exerciseIds": [
    "P5-Q048",
    "P5-Q049",
    "P5-Q050"
  ],
  "overview": "情态结构区分能力、可能性、允许、困难和无力完成；先问是谁、能否、是否允许。",
  "decisionSteps": [
    "判断能力还是条件许可",
    "确认体验者的格",
    "选择情态词和不定式"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "是会做、能做、可以做还是不得不做？",
      "是主观能力还是客观条件？"
    ],
    "structures": [
      "уметь + 不定式",
      "мочь + 不定式",
      "не в силах + 不定式",
      "с трудом + 动词"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "уметь 的技能",
      "scope": "core",
      "meaning": "уметь 表示通过学习掌握的能力。",
      "conditions": [
        "强调技能或本领。"
      ],
      "structure": "уметь + 不定式",
      "caseChanges": [
        {
          "from": "она",
          "to": "она умеет"
        }
      ],
      "examples": [
        {
          "ru": "Она умеет хорошо плавать.",
          "zh": "她很会游泳。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要用 мочь 替代所有技能。"
      ],
      "instantChecks": [
        {
