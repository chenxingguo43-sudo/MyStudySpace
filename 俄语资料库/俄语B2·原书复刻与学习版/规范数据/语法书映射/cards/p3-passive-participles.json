  "overview": "被动形动词说明名词是动作的承受者。先判断谁被做了什么，再处理体和性数格。",
  "decisionSteps": [
    "找承受动作的名词",
    "判断动作是否完成",
    "使形动词一致"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "谁是受事？",
      "动作有结果吗？"
    ],
    "structures": [
      "написанный + 名词",
      "читаемый + 名词",
      "письмо написано",
      "о написанном письме"
    ]
  },
  "lessons": [
    {
      "id": "l1",
      "title": "完成后的结果",
      "scope": "core",
      "meaning": "完成体被动形动词常表示已完成结果。",
      "conditions": [
        "名词承受了完成动作。"
      ],
      "structure": "написанный + 名词",
      "caseChanges": [
        {
          "from": "написанное письмо",
          "to": "написанного письма"
        }
      ],
      "examples": [
        {
          "ru": "Написанное письмо лежит на столе.",
          "zh": "写好的信放在桌上。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要把执行者误作中心名词。"
      ],
      "instantChecks": [
        {
          "id": "l1-check",
          "type": "judgment",
