{
  "id": "p1-motion-return",
  "partId": "p1",
  "knowledgePointId": "p1-motion-return",
  "title": "运动动词：去过、返回与未归",
  "exerciseIds": [
    "P1-Q055",
    "P1-Q056",
    "P1-Q057",
    "P1-Q058",
    "P1-Q059",
    "P1-Q060"
  ],
  "overview": "运动动词题的核心是方向、次数、是否已返回，以及前缀是否把“离开、到达、返回”变成结果。不要只按中文“去”选一个动词。",
  "decisionSteps": [
    "先判断动作是一条单向路线还是来回/多向。",
    "判断说话时主体是否已返回。",
    "检查是否强调离开、到达或返回的结果。",
    "最后选择定向、不定向或带前缀形式。"
  ],
  "reviewStatus": "approved",
  "quickReference": {
    "semanticQuestions": [
      "是一方向移动还是往返/多向？",
      "人现在在原地、目的地还是途中？",
      "动词是否要表达离开或返回结果？"
    ],
    "structures": [
      {
        "question": "去过又回",
        "structure": "ходил/ездил + 地点",
        "shortcut": "过去经历且已返回。"
      },
      {
        "question": "单向进行",
        "structure": "идти/ехать + 地点",
        "shortcut": "正沿一个方向移动或强调单程。"
      }
    ],
    "comparison": "Я ходил в магазин：去过并回来了；Я шёл в магазин：正在/当时往商店去。",
    "mnemonic": "先问：人现在回来了吗？路线是一条还是来回？"
  },
  "lessons": [
    {
      "id": "p1-motion-return-l1",
      "title": "定向与不定向",
      "scope": "core",
      "meaning": "定向动词描写一条具体方向；不定向动词适合往返、多向或一般活动。",
      "conditions": [
        "先判断路线和次数。"
      ],
      "structure": "идти/ехать vs ходить/ездить",
      "caseChanges": [
        {
          "from": "идти",
          "to": "Иду в школу"
        },
        {
          "from": "ходить",
          "to": "Хожу в школу"
        }
      ],
      "examples": [
        {
          "ru": "Сейчас я иду в школу.",
          "zh": "我现在正去学校。",
          "source": {
            "kind": "supplement-example",
            "label": "补充例句"
          }
        }
      ],
      "boundaries": [
        "不要用中文“去”直接决定。"
      ],
