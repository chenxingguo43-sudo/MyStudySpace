  ],
  "items": [
    {
      "i": 1,
      "sentence_id": "s0006-0071",
      "source_id": "diag-0006",
      "page_or_location": "33",
      "ru": "даже самой тяжёлой ситуации есть выход."
    },
    {
      "i": 2,
      "sentence_id": "s0006-0072",
      "source_id": "diag-0006",
      "page_or_location": "33",
      "ru": "возможности самому заработать на достойную жизнь."
    },
    {
      "i": 3,
      "sentence_id": "s0006-0073",
      "source_id": "diag-0006",
      "page_or_location": "34",
      "ru": "после такой долгой прогулки."
    },
    {
      "i": 4,
      "sentence_id": "s0006-0074",
      "source_id": "diag-0006",
      "page_or_location": "34",
      "ru": "не менее продолжал работать."
    },
    {
      "i": 5,
      "sentence_id": "s0006-0077",
      "source_id": "diag-0006",
      "page_or_location": "35",
      "ru": "хвастать вокальными данными."
    },
    {
      "i": 6,
      "sentence_id": "s0006-0079",
      "source_id": "diag-0006",
      "page_or_location": "36",
      "ru": "исполнил знаменитую итальянскую композицию 'O Sole Mio."
    },
    {
      "i": 7,
      "sentence_id": "s0006-0080",
      "source_id": "diag-0006",
      "page_or_location": "36",
      "ru": "Анисин пел так, будто занимался этим всю жизнь."
    },
    {
      "i": 8,
      "sentence_id": "s0006-0081",
      "source_id": "diag-0006",
      "page_or_location": "36",
      "ru": "продолжает петь до сих пор."
    },
    {
      "i": 9,
      "sentence_id": "s0006-0083",
      "source_id": "diag-0006",
      "page_or_location": "38",
      "ru": "Билялетдинов, как и Тарасов, оказались не чужды хип-хопу."
    },
    {
      "i": 10,
      "sentence_id": "s0006-0084",
      "source_id": "diag-0006",
      "page_or_location": "38",
      "ru": "глазах у всей страны, что, конечно, делает им честь."
    },
    {
      "i": 11,
      "sentence_id": "s0006-0086",
      "source_id": "diag-0006",
      "page_or_location": "38",
      "ru": "Дмитрий нисколько не стеснялся."
    },
    {
      "i": 12,
      "sentence_id": "s0006-0088",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "О дружбе Игоря Акинфеева и солиста группы \"Руки вверх\" Сергея Жукова известно всем."
    },
    {
      "i": 13,
      "sentence_id": "s0006-0089",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "Вратарь сборной России по футболу в детстве, как и вся страна, заслушивался песнями Жукова, а затем вырос, стал знаменитым вратарём и познакомился с любимым исполнителем."
    },
    {
      "i": 14,
      "sentence_id": "s0006-0090",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "Молодых людей уже не первый год связывают тёплые приятельские отношения, венцом которых стала запись совместной композиции \"Мой друг\"."
    },
    {
      "i": 15,
      "sentence_id": "s0006-0091",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "\"Наша дружба становится всё больше и больше, потому что Игорь уже крёстный нашей дочери."
    },
    {
      "i": 16,
      "sentence_id": "s0006-0092",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "Дружим семьями, можно сказать, мы уже родственники."
    },
    {
      "i": 17,
      "sentence_id": "s0006-0093",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "У нас общий круг знакомых."
    },
    {
      "i": 18,
      "sentence_id": "s0006-0094",
      "source_id": "diag-0006",
      "page_or_location": "39",
      "ru": "Единственное, о чём мы стараемся особо не говорить, -это ЦСКА и \"Руки вверх!\"\" - рассказывал о дружбе с Акинфеевым Жуков."
    },
    {
      "i": 19,
      "sentence_id": "s0006-0098",
      "source_id": "diag-0006",
      "page_or_location": "40",
      "ru": "Кроме того, оба засветились в клипах российских поп- исполнителей."
    },
    {
      "i": 20,
      "sentence_id": "s0006-0099",
      "source_id": "diag-0006",
      "page_or_location": "40",
      "ru": "Так, Овечкин принял участие в съёмках клипа Кати Лель на песню \"Пусть говорят\"."
    },
    {
      "i": 21,
      "sentence_id": "s0006-0100",
      "source_id": "diag-0006",
      "page_or_location": "40",
      "ru": "Хоккеиста с певицей связывают дружеские отношения."
    },
    {
      "i": 22,
      "sentence_id": "s0006-0101",
      "source_id": "diag-0006",
      "page_or_location": "40",
      "ru": "А в записи другого трека Лель, \"Долетай\", поучаствовал другой известный хоккеист -Павел Буре."
    },
    {
      "i": 23,
      "sentence_id": "s0006-0102",
      "source_id": "diag-0006",
      "page_or_location": "40",
      "ru": "Аллегровой и сестёр Ларионовых."
    },
    {
      "i": 24,
      "sentence_id": "s0006-0103",
      "source_id": "diag-0006",
      "page_or_location": "41",
      "ru": "Андрей Аршавин в любви к пению никогда замечен не был, благо у героя Евро есть и другие таланты."
    },
    {
      "i": 25,
      "sentence_id": "s0006-0106",
      "source_id": "diag-0006",
      "page_or_location": "43",
      "ru": "проблем, потому что мне повезло с мужем."
    },
    {
      "i": 26,
      "sentence_id": "s0006-0107",
      "source_id": "diag-0006",
      "page_or_location": "43",
      "ru": "другая семья, которая менее интенсивно работает, но зато много времени тратит на быт."
    },
    {
      "i": 27,
      "sentence_id": "s0006-0108",
      "source_id": "diag-0006",
      "page_or_location": "44",
      "ru": "- Елена, а у вас есть собственная формула успеха?"
    },
    {
      "i": 28,
      "sentence_id": "s0006-0110",
      "source_id": "diag-0006",
      "page_or_location": "44",
      "ru": "дальше с радостью этим занимается."
    },
    {
      "i": 29,
      "sentence_id": "s0006-0111",
      "source_id": "diag-0006",
      "page_or_location": "44",
      "ru": "недостаток, но в моём случае все сложилось очень удачно."
    },
    {
      "i": 30,
      "sentence_id": "s0006-0112",
      "source_id": "diag-0006",
      "page_or_location": "44",
      "ru": "нашем деле смена занятий поощряется."
    },
    {
      "i": 31,
      "sentence_id": "s0006-0114",
      "source_id": "diag-0006",
      "page_or_location": "45",
      "ru": "- Признайтесь, вам часто приходится идти на риск?"
    },
    {
      "i": 32,
      "sentence_id": "s0006-0115",
      "source_id": "diag-0006",
      "page_or_location": "45",
      "ru": "Наш издательский дом не самый авантюрный."
    },
    {
      "i": 33,
      "sentence_id": "s0006-0116",
      "source_id": "diag-0006",
      "page_or_location": "45",
      "ru": "нет мощной международной корпорации."
    },
    {
      "i": 34,
      "sentence_id": "s0006-0117",
      "source_id": "diag-0006",
      "page_or_location": "45",
      "ru": "то теряем текущие заработки, ведь мы живём только на то, что зарабатываем."
    },
    {
      "i": 35,
      "sentence_id": "s0006-0118",
      "source_id": "diag-0006",
      "page_or_location": "45",
      "ru": "Поэтому мы достаточно осторожны."
    },
    {
      "i": 36,
      "sentence_id": "s0006-0119",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "- А как бы вы определили, что такое феминизм?"
    },
    {
      "i": 37,
      "sentence_id": "s0006-0120",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "- Мне трудно отвечать на этот вопрос."
    },
    {
      "i": 38,
      "sentence_id": "s0006-0122",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "феминизм, и феминизму не чужда она."
    },
    {
      "i": 39,
      "sentence_id": "s0006-0123",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "женщина, уверенная в себе, вовсе не угроза для мужчины."
    },
    {
      "i": 40,
      "sentence_id": "s0006-0124",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "любую состоявшуюся женщину они воспринимали в штыки."
    },
    {
      "i": 41,
      "sentence_id": "s0006-0126",
      "source_id": "diag-0006",
      "page_or_location": "46",
      "ru": "Они поняли, что женщины не претендуют на их успех."
    },
    {
      "i": 42,
      "sentence_id": "s0006-0127",
      "source_id": "diag-0006",
      "page_or_location": "47",
      "ru": "выпустила доклад \"Краткий обзор образования - 2012\"."
    },
    {
      "i": 43,
      "sentence_id": "s0006-0128",
      "source_id": "diag-0006",
      "page_or_location": "47",
      "ru": "Канада и Россия, занимающая первое место."
    },
    {
      "i": 44,
      "sentence_id": "s0006-0129",
      "source_id": "diag-0006",
      "page_or_location": "47",
      "ru": "образование в России получает 54 % населения."
    },
    {
      "i": 45,
      "sentence_id": "s0006-0130",
      "source_id": "diag-0006",
      "page_or_location": "47",
      "ru": "имеют профессионально-техническое образование."
    },
    {
      "i": 46,
      "sentence_id": "s0006-0132",
      "source_id": "diag-0006",
      "page_or_location": "47",
      "ru": "рубежом, учится в России."
    },
    {
      "i": 47,
      "sentence_id": "s0006-0133",
      "source_id": "diag-0006",
      "page_or_location": "48",
      "ru": "привлечение иностранной рабочей силы на следующий год."
    },
    {
      "i": 48,
      "sentence_id": "s0006-0134",
      "source_id": "diag-0006",
      "page_or_location": "48",
      "ru": "показывают, что потребность в иностранцах падает."
    },
    {
      "i": 49,
      "sentence_id": "s0006-0136",
      "source_id": "diag-0006",
      "page_or_location": "49",
      "ru": "получавшего каких-либо замечаний."
    },
    {
      "i": 50,
      "sentence_id": "s0006-0138",
      "source_id": "diag-0006",
      "page_or_location": "49",
      "ru": "удалось поймать лишь одну мышь."
    }
  ]
}