    },
    {
      "i": 15,
      "sentence_id": "s0006-0023",
      "source_id": "diag-0006",
      "page_or_location": "14",
      "ru": "Прочитав книгу, он понял смысл."
    },
    {
      "i": 16,
      "sentence_id": "s0006-0025",
      "source_id": "diag-0006",
      "page_or_location": "18",
      "ru": "требует немедленного решения."
    },
    {
      "i": 17,
      "sentence_id": "s0006-0026",
      "source_id": "diag-0006",
      "page_or_location": "18",
      "ru": "требует немедленного решения."
